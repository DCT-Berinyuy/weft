.{
    .workspace = "weft",
    .environments = .{
        .{
            .name = "docs",
            .pkgs = .{
                "il1g4zw7ngwvsnn051z8zj1vr2v9pwg1-lowdown-3.0.1",
            },
        },
        .{
            .name = "zig",
            .pkgs = .{
                "83qs3ksyjclr149vpxbaz1z18wvi9rms-zig-0.16.0",
            },
        },
    },
    .pipelines = .{
        .{
            .name = "docs",
            .uses = .{"docs"},
            .in = .{"src"},
            .out = .{"docs"},
        },
        .{
            .name = "build",
            .in = .{"src"},
            .out = .{"bin"},
            .uses = .{"zig"},
            .keep = .{
                .{ "zig-cache", ".zig-cache" },
            },
        },
    },
}
